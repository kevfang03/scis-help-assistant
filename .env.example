# SCIS Help Assistant settings. Copy to .env and change what you need. Every line is optional
# and shows the default. Non-secret settings only: the API key lives in keyring, never here.
# Environment variables use the same names and win over this file.

# --- Crawler (public support site, sitemap pages only) ---
# Site root; only pages on this host that its sitemap.xml lists are fetched.
SCIS_HELP_CRAWL__BASE_URL=https://support.cci.drexel.edu/
# Seconds between requests (minimum 1.0).
SCIS_HELP_CRAWL__DELAY_SECONDS=1.5
# Most page fetches in one crawl.
SCIS_HELP_CRAWL__MAX_PAGES=2000
# Per-request timeout in seconds.
SCIS_HELP_CRAWL__TIMEOUT_SECONDS=20.0

# --- Index ---
# fastembed model id; after changing it, run `scis-help index` again.
SCIS_HELP_INDEX__EMBED_MODEL=BAAI/bge-small-en-v1.5
# Chunk size range in words (sections are merged or split to fit).
SCIS_HELP_INDEX__CHUNK_MIN_WORDS=150
SCIS_HELP_INDEX__CHUNK_MAX_WORDS=450

# --- Retrieval ---
# Chunks returned per search (1-20).
SCIS_HELP_RETRIEVAL__K=5
# Candidates taken from each retriever (dense and BM25) before fusion.
SCIS_HELP_RETRIEVAL__CANDIDATES=20
# Most chunks from one page in a result.
SCIS_HELP_RETRIEVAL__MAX_CHUNKS_PER_PAGE=2
# A search is confident when the best dense cosine reaches MIN_SCORE
# or the best BM25 score reaches MIN_BM25.
SCIS_HELP_RETRIEVAL__MIN_SCORE=0.55
SCIS_HELP_RETRIEVAL__MIN_BM25=5.0

# Not a setting but read from the environment: SCIS_HELP_HOME moves the data and cache
# folders under one directory (used by the tests).
